# ==============================================================================
# ARCHive Network - optional machine settings (.env.example)
# `.env` is optional: every setting below has a default. Copy this file to `.env`
# in the repo root and uncomment only what you need to change.
# Backend settings use the ARCHIVENETWORK_ prefix; real environment variables win.
# ==============================================================================

# AWS settings live in environments.local.toml (see environments.local.toml.example).

# Root directory for imports, selection state, sign-in cache and `ready/` output.
# ARCHIVENETWORK_WORKSPACE_DIR=workspace

# 7-Zip binary used to extract export zips (default: the vendored one in vendor/).
# ARCHIVENETWORK_SEVEN_ZIP_EXE=

# Where the JSON API listens.
# ARCHIVENETWORK_HOST=127.0.0.1
# ARCHIVENETWORK_PORT=8000

# Photos a volunteer may pick per album.
# ARCHIVENETWORK_MAX_PER_ALBUM=10

# Startup check of the floci version against GitHub (one network call); false when offline.
# ARCHIVENETWORK_FLOCI_VERSION_CHECK=true
