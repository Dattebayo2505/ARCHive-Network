# ==============================================================================
# ARCHive Network - Environment Configuration Template (.env.example)
# Copy this file to `.env` in the project root to configure local settings.
# All backend settings use the ARCHIVENETWORK_ prefix (pydantic-settings).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dev-Mode & Database Configuration (Downstream ETL)
# ------------------------------------------------------------------------------
# Setting DATABASE_URL enables Dev-Mode. If unset, dev mode is disabled and
# all `/api/dev/*` routes return 404.
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>
ARCHIVENETWORK_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/archivenetwork_dev

# Root directory for the local dev object store (stands in for S3 bucket).
# Must NOT be named `media` (keys already begin with `fb-exports/...` or `media/...`).
ARCHIVENETWORK_MEDIA_ROOT=workspace/store

# Base URL where local object store is served. In production, this is a CDN domain.
ARCHIVENETWORK_MEDIA_BASE_URL=/store


# ------------------------------------------------------------------------------
# 2. Production AWS S3 Storage (On-demand upload)
# ------------------------------------------------------------------------------
# Target AWS S3 bucket for uploading curated exports.
ARCHIVENETWORK_S3_BUCKET=
ARCHIVENETWORK_S3_REGION=

# Optional explicit credentials. If left unset, boto3 resolves credentials via
# standard AWS credential chain (~/.aws/credentials, SSO, IAM roles, env vars).
ARCHIVENETWORK_S3_ACCESS_KEY_ID=
ARCHIVENETWORK_S3_SECRET_ACCESS_KEY=


# ------------------------------------------------------------------------------
# 3. Floci S3 Emulator (Local Testing Target)
# ------------------------------------------------------------------------------
# LocalStack / Floci local emulator endpoint for S3 upload testing.
# Start with `docker compose up -d` (uses port 4566, UI on port 4500).
ARCHIVENETWORK_FLOCI_ENDPOINT_URL=http://127.0.0.1:4566
ARCHIVENETWORK_FLOCI_BUCKET=archivenetwork-dev


# ------------------------------------------------------------------------------
# 4. Pipeline & Curation Settings
# ------------------------------------------------------------------------------
# Root directory for all generated state, imports, and `ready/` output.
ARCHIVENETWORK_WORKSPACE_DIR=workspace
